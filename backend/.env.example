APP_NAME=CareFlow AI
# Use production (or another non-development value) to enable Secure auth cookies.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/careflow
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-key
SUPABASE_IMPORT_BUCKET=careflow-patient-imports
# S3-compatible Floci storage for new patient import uploads.
FLOCI_S3_ENDPOINT_URL=https://aws-api.meissasoft.com
FLOCI_S3_REGION=us-east-1
FLOCI_S3_BUCKET=patients
FLOCI_S3_ACCESS_KEY_ID=replace-with-floci-access-key-id
FLOCI_S3_SECRET_ACCESS_KEY=replace-with-floci-secret-access-key
# Optional; only set for temporary STS credentials.
# FLOCI_S3_SESSION_TOKEN=
# Keep enabled during the transition so existing imports stored in Supabase remain readable.
FLOCI_S3_LEGACY_SUPABASE_READ=true
# Set once for initial platform-admin provisioning, then remove from the runtime.
SUPER_ADMIN_BOOTSTRAP_KEY=replace-with-a-long-random-one-time-secret
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
